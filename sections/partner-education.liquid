{%- comment -%}
  Section: Partner Education
  Displays eye health educational resource cards.
  Block types:
    - resource_card: static card with manually entered title, description, and link
    - latest_article: dynamic card showing the most recent article from a chosen blog
{%- endcomment -%}

<section class="partner-education">
  <div class="partner-container">
    <h2 class="partner-section-title">{{ section.settings.heading }}</h2>
    <p class="partner-section-subtitle">{{ section.settings.subheading }}</p>
    <div class="partner-education__grid">
      {%- for block in section.blocks -%}
        {%- assign render_card = false -%}
        {%- assign card_title = '' -%}
        {%- assign card_desc = '' -%}
        {%- assign card_link = '' -%}
        {%- assign card_link_text = '' -%}
        {%- assign card_icon = block.settings.icon -%}

        {%- if block.type == 'resource_card' -%}
          {%- assign card_title = block.settings.title -%}
          {%- assign card_desc = block.settings.description -%}
          {%- assign card_link = block.settings.link_url -%}
          {%- assign card_link_text = block.settings.link_text | default: 'Learn More' -%}
          {%- if card_title != blank -%}
            {%- assign render_card = true -%}
          {%- endif -%}

        {%- elsif block.type == 'latest_article' -%}
          {%- assign blog = blogs[block.settings.blog_handle] -%}
          {%- if blog != blank and blog.articles.size > 0 -%}
            {%- assign article = blog.articles.first -%}
            {%- assign card_title = article.title -%}
            {%- assign card_desc = article.excerpt_or_content | strip_html | truncate: 120 -%}
            {%- assign card_link = article.url -%}
            {%- assign card_link_text = block.settings.link_text | default: 'Read Article' -%}
            {%- assign render_card = true -%}
          {%- endif -%}
        {%- endif -%}

        {%- if render_card -%}
          <div class="partner-education__card" {{ block.shopify_attributes }}>
            <div class="partner-education__icon">
              {%- case card_icon -%}
                {%- when 'book' -%}
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
                {%- when 'heart' -%}
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
                {%- when 'clipboard' -%}
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><rect x="8" y="2" width="8" height="4" rx="1" ry="1"/></svg>
                {%- when 'newspaper' -%}
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 22h16a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v16a2 2 0 0 1-2 2Zm0 0a2 2 0 0 1-2-2v-9c0-1.1.9-2 2-2h2"/><path d="M18 14h-8M15 18h-5M10 6h8v4h-8z"/></svg>
              {%- endcase -%}
            </div>
            <h3 class="partner-education__card-title">{{ card_title }}</h3>
            <p class="partner-education__card-desc">{{ card_desc }}</p>
            {%- if card_link != blank -%}
              <a href="{{ card_link }}" class="partner-education__card-link">
                {{ card_link_text }} &rarr;
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

<style>
  .partner-education { background: var(--partner-page-bg); padding: 80px 0; }
  .partner-education__grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 24px; margin-top: 40px; }
  .partner-education__card { background: var(--partner-card-bg); border: 1px solid var(--partner-card-border); border-radius: var(--partner-radius-md); padding: 28px; box-shadow: var(--partner-card-shadow); transition: all 0.25s ease; }
  .partner-education__card:hover { box-shadow: var(--partner-card-shadow-hover); transform: translateY(-2px); }
  .partner-education__icon { width: 48px; height: 48px; border-radius: var(--partner-radius-sm); display: flex; align-items: center; justify-content: center; margin-bottom: 20px; background: var(--partner-primary-10); color: var(--partner-primary); }
  .partner-education__card-title { font-size: 18px; font-weight: 600; color: var(--partner-text-heading); margin: 0 0 8px; }
  .partner-education__card-desc { font-size: 14px; color: var(--partner-text-muted); line-height: 1.6; margin: 0 0 16px; }
  .partner-education__card-link { font-size: 14px; font-weight: 600; color: var(--partner-primary); text-decoration: none; }
  .partner-education__card-link:hover { opacity: 0.8; }
  @media (max-width: 768px) { .partner-education { padding: 48px 0; } .partner-education__grid { grid-template-columns: 1fr; gap: 16px; } }
</style>

{% schema %}
{
  "name": "Partner Education",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Learn More About Your Eye Health" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "At Peeq Pro, we believe education empowers better care. Explore resources to help you manage your eye health." }
  ],
  "blocks": [
    {
      "type": "resource_card",
      "name": "Resource Card",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Resource Title" },
        { "type": "textarea", "id": "description", "label": "Description" },
        { "type": "select", "id": "icon", "label": "Icon", "options": [ { "value": "book", "label": "Book" }, { "value": "heart", "label": "Heart" }, { "value": "clipboard", "label": "Clipboard" }, { "value": "newspaper", "label": "Newspaper" } ], "default": "book" },
        { "type": "url", "id": "link_url", "label": "Link URL", "info": "Use a relative path for internal links (e.g. /blogs/blogs-for-consumers)" },
        { "type": "text", "id": "link_text", "label": "Link Text", "default": "Learn More" }
      ]
    },
    {
      "type": "latest_article",
      "name": "Latest Blog Article",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "blog_handle", "label": "Blog handle", "default": "blogs-for-consumers", "info": "The handle of the blog to pull the most recent article from. Card hides if the blog has no articles." },
        { "type": "select", "id": "icon", "label": "Icon", "options": [ { "value": "book", "label": "Book" }, { "value": "heart", "label": "Heart" }, { "value": "clipboard", "label": "Clipboard" }, { "value": "newspaper", "label": "Newspaper" } ], "default": "newspaper" },
        { "type": "text", "id": "link_text", "label": "Link Text", "default": "Read Article" }
      ]
    }
  ],
  "presets": [{ "name": "Partner Education", "blocks": [
    { "type": "resource_card", "settings": { "title": "Eye Care Articles", "description": "Explore our full collection of expert articles on eye health, dry eye care, and wellness tips.", "icon": "book", "link_url": "/blogs/blogs-for-consumers", "link_text": "See All" } },
    { "type": "resource_card", "settings": { "title": "Menopause & Eye Health", "description": "How hormonal changes can affect dryness, comfort, and vision.", "icon": "heart", "link_url": "/pages/menopause", "link_text": "Learn More" } },
    { "type": "resource_card", "settings": { "title": "Good, Better, Best Dry Eye Care", "description": "A simple, step-by-step routine to help you manage dry eye symptoms at any level.", "icon": "clipboard", "link_url": "/blogs/blogs-for-consumers/a-simple-routine-for-managing-dry-eye-good-better-best", "link_text": "Read Article" } },
    { "type": "latest_article", "settings": { "blog_handle": "blogs-for-consumers", "icon": "newspaper", "link_text": "Read Article" } }
  ]}]
}
{% endschema %}

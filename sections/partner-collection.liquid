{%- comment -%}
  Section: Partner Collection
  Displays curated products from the partner collection plus Custom Kits
  from the global "All Affiliate Boxes" collection when the title contains
  the current partner_name.
{%- endcomment -%}

{%- assign partner_name = page.metafields.custom.partner_name | default: 'Your Provider' -%}
{%- assign collection = page.metafields.custom.partner_landing_collection.value -%}
{%- assign affiliate_boxes = collections['all-boxes'] -%}

{%- assign partner_second_color = page.metafields.custom.partner_second_color | default: '' -%}
{%- assign partner_txt_color = page.metafields.custom.partner_txt_color.value | default: '' -%}

{%- assign partner_name_match = partner_name | downcase | strip -%}

<section class="partner-collection" id="partner-products">
  <div class="partner-container">
    <h2 class="partner-section-title">{{ section.settings.heading }}</h2>
    <p class="partner-section-subtitle">
      {{ section.settings.subheading | replace: '[partner_name]', partner_name }}
    </p>

    {%- if section.settings.show_filters -%}
      {%- assign all_products_count = 0 -%}
      {%- if collection != blank and collection.products.size > 0 -%}
        {%- for product in collection.products limit: section.settings.max_products -%}
          {%- assign all_products_count = all_products_count | plus: 1 -%}
        {%- endfor -%}
      {%- endif -%}

      <div class="partner-collection__filters" id="partner-filters-{{ section.id }}">
        {%- if all_products_count > 0 -%}
          <button class="partner-collection__filter-btn active" data-filter="all">All Products</button>
        {%- endif -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'filter_tab' -%}
            {%- assign filter_key = block.settings.label | handleize -%}
            {%- assign title_phrase = block.settings.tag | downcase | strip -%}
            {%- assign filter_count = 0 -%}

            {%- if filter_key == 'custom-kits' -%}
              {%- if affiliate_boxes != blank and affiliate_boxes.products.size > 0 and partner_name_match != blank -%}
                {%- for product in affiliate_boxes.products -%}
                  {%- assign product_title_match = product.title | downcase -%}
                  {%- if product_title_match contains partner_name_match -%}
                    {%- assign filter_count = filter_count | plus: 1 -%}
                  {%- endif -%}
                {%- endfor -%}
              {%- endif -%}
            {%- else -%}
              {%- if collection != blank and title_phrase != blank -%}
                {%- for product in collection.products limit: section.settings.max_products -%}
                  {%- assign product_title_match = product.title | downcase -%}
                  {%- if product_title_match contains title_phrase -%}
                    {%- assign filter_count = filter_count | plus: 1 -%}
                  {%- endif -%}
                {%- endfor -%}
              {%- endif -%}
            {%- endif -%}

            {%- if filter_count > 0 -%}
              <button
                class="partner-collection__filter-btn"
                data-filter="{{ filter_key }}"
                {{ block.shopify_attributes }}
              >
                {{ block.settings.label }}
              </button>
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- assign rendered_count = 0 -%}

    <div class="partner-collection__grid" id="partner-products-grid-{{ section.id }}">
      {%- if collection != blank and collection.products.size > 0 -%}
        {%- for product in collection.products limit: section.settings.max_products -%}
          {%- assign product_title_match = product.title | downcase -%}
          {%- assign card_groups = 'all' -%}

          {%- for block in section.blocks -%}
            {%- if block.type == 'filter_tab' -%}
              {%- assign filter_key = block.settings.label | handleize -%}
              {%- assign title_phrase = block.settings.tag | downcase | strip -%}

              {%- comment -%}
                Custom Kits is handled from affiliate_boxes below, not from the main partner collection.
              {%- endcomment -%}
              {%- if filter_key != 'custom-kits' and title_phrase != blank and product_title_match contains title_phrase -%}
                {%- assign card_groups = card_groups | append: ',' | append: filter_key -%}
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}

          {%- assign rendered_count = rendered_count | plus: 1 -%}

          <div class="partner-collection__card" data-groups="{{ card_groups }}">
            <a href="{{ product.url }}" class="partner-collection__card-link">
              <div class="partner-collection__card-image">
                {%- if product.featured_image != blank -%}
                  <img
                    src="{{ product.featured_image | image_url: width: 400 }}"
                    alt="{{ product.featured_image.alt | escape }}"
                    loading="lazy"
                    width="400"
                    height="400"
                  >
                {%- else -%}
                  <div class="partner-collection__card-placeholder">
                    <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" opacity="0.3">
                      <rect x="3" y="3" width="18" height="18" rx="2"/>
                    </svg>
                  </div>
                {%- endif -%}
              </div>
              <div class="partner-collection__card-body">
                <h3 class="partner-collection__card-title">{{ product.title }}</h3>
                <p class="partner-collection__card-desc">{{ product.description | strip_html | truncate: 100 }}</p>
                <div class="partner-collection__card-footer">
                  <span class="partner-collection__card-price">{{ product.price | money }}</span>
                  <span class="partner-collection__card-cta">View Details &nearr;</span>
                </div>
              </div>
            </a>
          </div>
        {%- endfor -%}
      {%- endif -%}

      {%- comment -%}
        Custom Kits:
        Show products from the global All Affiliate Boxes collection
        where the product title contains the current partner_name.
      {%- endcomment -%}
      {%- if section.settings.show_filters and affiliate_boxes != blank and affiliate_boxes.products.size > 0 and partner_name_match != blank -%}
        {%- for product in affiliate_boxes.products -%}
          {%- assign product_title_match = product.title | downcase -%}
          {%- if product_title_match contains partner_name_match -%}
            {%- assign rendered_count = rendered_count | plus: 1 -%}

            <div class="partner-collection__card hidden" data-groups="custom-kits">
              <a href="{{ product.url }}" class="partner-collection__card-link">
                <div class="partner-collection__card-image">
                  {%- if product.featured_image != blank -%}
                    <img
                      src="{{ product.featured_image | image_url: width: 400 }}"
                      alt="{{ product.featured_image.alt | escape }}"
                      loading="lazy"
                      width="400"
                      height="400"
                    >
                  {%- else -%}
                    <div class="partner-collection__card-placeholder">
                      <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" opacity="0.3">
                        <rect x="3" y="3" width="18" height="18" rx="2"/>
                      </svg>
                    </div>
                  {%- endif -%}
                </div>
                <div class="partner-collection__card-body">
                  <h3 class="partner-collection__card-title">{{ product.title }}</h3>
                  <p class="partner-collection__card-desc">{{ product.description | strip_html | truncate: 100 }}</p>
                  <div class="partner-collection__card-footer">
                    <span class="partner-collection__card-price">{{ product.price | money }}</span>
                    <span class="partner-collection__card-cta">View Details &nearr;</span>
                  </div>
                </div>
              </a>
            </div>
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
    </div>

    {%- if rendered_count == 0 -%}
      <div class="partner-collection__empty">
        <p>Products coming soon. Check back later!</p>
      </div>
    {%- endif -%}
  </div>
</section>

<style>
  .partner-collection { background: var(--partner-section-bg); padding: 80px 0; }
  .partner-collection__filters { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; margin: 32px 0 40px; }
  .partner-collection__filter-btn { padding: 10px 20px; border-radius: var(--partner-radius-full); border: 1.5px solid var(--partner-card-border); background: var(--partner-card-bg); color: var(--partner-text-body); font-size: 14px; font-weight: 500; cursor: pointer; transition: all 0.2s ease; }
  .partner-collection__filter-btn:hover { border-color: var(--partner-primary); color: var(--partner-primary); }
  .partner-collection__filter-btn.active { background: var(--partner-primary); color: var(--partner-btn-primary-text); border-color: var(--partner-primary); }
  .partner-collection__grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; }
  .partner-collection__card { background: var(--partner-card-bg); border: 1px solid var(--partner-card-border); border-radius: var(--partner-radius-md); overflow: hidden; box-shadow: var(--partner-card-shadow); transition: all 0.25s ease; }
  .partner-collection__card:hover { box-shadow: var(--partner-card-shadow-hover); transform: translateY(-2px); }
  .partner-collection__card.hidden { display: none; }
  .partner-collection__card-link { text-decoration: none; color: inherit; display: block; }
  .partner-collection__card-image { aspect-ratio: 1; overflow: hidden; background: var(--partner-section-bg-alt); display: flex; align-items: center; justify-content: center; }
  .partner-collection__card-image img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.3s ease; }
  .partner-collection__card:hover .partner-collection__card-image img { transform: scale(1.05); }
  .partner-collection__card-body { padding: 16px; }
  .partner-collection__card-title { font-size: 15px; font-weight: 600; color: var(--partner-text-heading); margin: 0 0 6px; line-height: 1.3; }
  .partner-collection__card-desc { font-size: 13px; color: var(--partner-text-muted); margin: 0 0 12px; line-height: 1.5; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .partner-collection__card-footer { display: flex; justify-content: space-between; align-items: center; }
  .partner-collection__card-price { font-size: 15px; font-weight: 700; color: var(--partner-text-heading); }
  .partner-collection__card-cta { font-size: 13px; font-weight: 600; color: var(--partner-primary); }
  .partner-collection__empty { text-align: center; padding: 60px 0; color: var(--partner-text-muted); }
  @media (max-width: 1024px) { .partner-collection__grid { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 768px) {
    .partner-collection { padding: 48px 0; }
    .partner-collection__grid { grid-template-columns: repeat(2, 1fr); gap: 16px; }
    .partner-collection__filters { gap: 8px; }
    .partner-collection__filter-btn { padding: 8px 14px; font-size: 12px; }
  }
  @media (max-width: 480px) { .partner-collection__grid { grid-template-columns: 1fr; } }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    document.querySelectorAll('.partner-collection').forEach(function(section) {
      var filters = section.querySelectorAll('.partner-collection__filter-btn');
      var cards = section.querySelectorAll('.partner-collection__card');

      function applyFilter(filter) {
        cards.forEach(function(card) {
          var groups = (card.getAttribute('data-groups') || '')
            .toLowerCase()
            .split(',')
            .map(function(item) { return item.trim(); })
            .filter(function(item) { return item !== ''; });

          if (filter === 'all') {
            if (groups.indexOf('all') !== -1) {
              card.classList.remove('hidden');
            } else {
              card.classList.add('hidden');
            }
          } else {
            if (groups.indexOf(filter) !== -1) {
              card.classList.remove('hidden');
            } else {
              card.classList.add('hidden');
            }
          }
        });
      }

      filters.forEach(function(btn) {
        btn.addEventListener('click', function() {
          var filter = btn.getAttribute('data-filter');

          filters.forEach(function(b) {
            b.classList.remove('active');
          });

          btn.classList.add('active');
          applyFilter(filter);
        });
      });

      applyFilter('all');
    });
  });
</script>

{% schema %}
{
  "name": "Partner Collection",
  "tag": "div",
  "class": "partner-page",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Curated Collection" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "This collection includes only the products recommended by [partner_name]. Your provider may update these recommendations over time.", "info": "Use [partner_name] to insert the partner name" },
    { "type": "checkbox", "id": "show_filters", "label": "Show category filter tabs", "default": true },
    { "type": "range", "id": "max_products", "label": "Max products", "min": 4, "max": 24, "step": 4, "default": 12 }
  ],
  "blocks": [
    {
      "type": "filter_tab",
      "name": "Filter Tab",
      "settings": [
        { "type": "text", "id": "label", "label": "Tab Label", "default": "Category" },
        { "type": "text", "id": "tag", "label": "Word or phrase to find in product titles", "info": "For Custom Kits, this field is ignored. For other tabs, products from the partner collection are matched when their title contains this phrase." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Partner Collection",
      "blocks": [
        { "type": "filter_tab", "settings": { "label": "Custom Kits", "tag": "" } },
        { "type": "filter_tab", "settings": { "label": "Specialty Boxes", "tag": "box" } },
        { "type": "filter_tab", "settings": { "label": "Eye Drops & Lubricants", "tag": "eye drops" } },
        { "type": "filter_tab", "settings": { "label": "Warm Compresses", "tag": "mask" } },
        { "type": "filter_tab", "settings": { "label": "Supplements", "tag": "vitamins" } }
      ]
    }
  ]
}
{% endschema %}
{%- assign partner_name = page.metafields.custom.partner_name | default: 'Our Partner' -%}
{%- assign partner_instagram = page.metafields.custom.partner_instagram_url -%}
{%- assign office_photos = page.metafields.custom.partner_office_photos.value -%}

<section class="partner-social">
  <div class="partner-container">
    <h2 class="partner-section-title">{{ section.settings.heading }}</h2>
    <p class="partner-section-subtitle">
      {{ section.settings.subheading | replace: '[partner_name]', partner_name }}
    </p>

    <div class="partner-social__buttons">
      {%- if partner_instagram != blank -%}
        <a href="{{ partner_instagram }}" target="_blank" rel="noopener" class="partner-btn partner-btn--outline">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/></svg>
          Follow {{ partner_name }}
        </a>
      {%- endif -%}
      {%- if section.settings.peeq_instagram != blank -%}
        <a href="{{ section.settings.peeq_instagram }}" target="_blank" rel="noopener" class="partner-btn partner-btn--outline">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/></svg>
          Follow Peeq Pro
        </a>
      {%- endif -%}
    </div>

    {%- assign has_photos = false -%}
    {%- if office_photos != blank and office_photos.size > 0 -%}
      {%- assign has_photos = true -%}
    {%- endif -%}

    {%- assign has_articles = false -%}
    {%- assign blog = nil -%}
    {%- if section.settings.blog_handle != blank -%}
      {%- assign blog = blogs[section.settings.blog_handle] -%}
      {%- if blog != blank and blog.articles.size > 0 -%}
        {%- assign has_articles = true -%}
      {%- endif -%}
    {%- endif -%}

    {%- if has_photos or has_articles -%}
      <div class="partner-social__carousel-wrapper">
        <div class="partner-social__carousel">
          {%- assign max_photos = 4 -%}
          {%- assign max_articles = section.settings.max_articles -%}

          {%- for i in (0..15) -%}
            {%- assign slot_mod = i | modulo: 2 -%}

            {%- if slot_mod == 0 -%}
              {%- assign photo_idx = i | divided_by: 2 -%}
              {%- if photo_idx < max_photos and has_photos -%}
                {%- assign photo = nil -%}
                {%- for p in office_photos limit: 1 offset: photo_idx -%}
                  {%- assign photo = p -%}
                {%- endfor -%}
                {%- if photo != nil and photo != blank -%}
                  <div class="partner-social__photo-card">
                    <img
                      src="{{ photo | image_url: width: 400, height: 300, crop: 'center' }}"
                      alt="{{ photo.alt | escape }}"
                      loading="lazy"
                    >
                  </div>
                {%- endif -%}
              {%- endif -%}

            {%- else -%}
              {%- assign article_idx = i | minus: 1 | divided_by: 2 -%}
              {%- if article_idx < max_articles and has_articles -%}
                {%- assign article = nil -%}
                {%- for a in blog.articles limit: 1 offset: article_idx -%}
                  {%- assign article = a -%}
                {%- endfor -%}
                {%- if article != nil -%}
                  <a href="{{ article.url }}" class="partner-social__article-card">
                    {%- if article.image != blank -%}
                      <div class="partner-social__article-image">
                        <img src="{{ article.image | image_url: width: 400, height: 280, crop: 'center' }}" alt="{{ article.image.alt | escape }}" loading="lazy">
                      </div>
                    {%- else -%}
                      <div class="partner-social__article-image partner-social__article-image--placeholder">
                        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" opacity="0.3"><rect x="3" y="3" width="18" height="18" rx="2"/></svg>
                      </div>
                    {%- endif -%}
                    <div class="partner-social__article-body">
                      <span class="partner-social__article-tag">Peeq Pro</span>
                      <h4 class="partner-social__article-title">{{ article.title }}</h4>
                      <p class="partner-social__article-excerpt">{{ article.excerpt_or_content | strip_html | truncate: 120 }}</p>
                    </div>
                  </a>
                {%- endif -%}
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
        <div class="partner-social__scroll-dots" aria-hidden="true"></div>
      </div>
    {%- endif -%}
  </div>
</section>

<style>
  .partner-social { background: var(--partner-section-bg); padding: 80px 0; }
  .partner-social__buttons { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; margin: 32px 0 40px; }
  .partner-social__carousel-wrapper { position: relative; }
  .partner-social__carousel { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; scroll-behavior: smooth; gap: 20px; padding-bottom: 16px; -webkit-overflow-scrolling: touch; scrollbar-width: thin; scrollbar-color: var(--partner-secondary) transparent; }
  .partner-social__carousel::-webkit-scrollbar { height: 8px; }
  .partner-social__carousel::-webkit-scrollbar-track { background: transparent; }
  .partner-social__carousel::-webkit-scrollbar-thumb { background: var(--partner-secondary); border-radius: 4px; }
  .partner-social__article-card,
  .partner-social__photo-card { flex: 0 0 280px; width: 280px; scroll-snap-align: start; }
  .partner-social__photo-card { border-radius: var(--partner-radius-md); overflow: hidden; border: 2px solid var(--partner-secondary); box-shadow: var(--partner-card-shadow); }
  .partner-social__photo-card img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .partner-social__article-card { background: var(--partner-card-bg); border: 2px solid var(--partner-secondary); border-radius: var(--partner-radius-md); overflow: hidden; text-decoration: none; color: inherit; box-shadow: var(--partner-card-shadow); transition: all 0.25s ease; }
  .partner-social__article-card:hover { box-shadow: var(--partner-card-shadow-hover); transform: translateY(-2px); }
  .partner-social__article-image { aspect-ratio: 16/11; overflow: hidden; background: var(--partner-section-bg-alt); display: flex; align-items: center; justify-content: center; }
  .partner-social__article-image img { width: 100%; height: 100%; object-fit: cover; }
  .partner-social__article-body { padding: 16px; }
  .partner-social__article-tag { display: inline-block; font-size: 11px; font-weight: 600; color: var(--partner-primary); background: var(--partner-primary-10); padding: 3px 8px; border-radius: var(--partner-radius-sm); margin-bottom: 8px; }
  .partner-social__article-title { font-size: 15px; font-weight: 600; color: var(--partner-text-heading); margin: 0 0 6px; line-height: 1.3; }
  .partner-social__article-excerpt { font-size: 13px; color: var(--partner-text-muted); margin: 0; line-height: 1.5; }
  .partner-social__scroll-dots { display: flex; justify-content: center; gap: 8px; margin-top: 20px; }
  .partner-social__scroll-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--partner-card-border); border: none; cursor: pointer; padding: 0; transition: background 0.2s ease; }
  .partner-social__scroll-dot.active { background: var(--partner-primary); }
  @media (max-width: 768px) { .partner-social { padding: 48px 0; } .partner-social__article-card, .partner-social__photo-card { flex: 0 0 240px; width: 240px; } }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    document.querySelectorAll('.partner-social__carousel').forEach(function(carousel) {
      var wrapper = carousel.parentElement;
      var dots = wrapper.querySelector('.partner-social__scroll-dots');

      function buildDots() {
        if (!dots || carousel.scrollWidth <= carousel.clientWidth) {
          if (dots) dots.style.display = 'none';
          return;
        }
        dots.style.display = '';
        var pageCount = Math.ceil(carousel.scrollWidth / carousel.clientWidth);
        dots.innerHTML = '';
        for (var i = 0; i < pageCount; i++) {
          var dot = document.createElement('button');
          dot.className = 'partner-social__scroll-dot';
          dot.setAttribute('aria-label', 'Go to page ' + (i + 1));
          (function(page) {
            dot.addEventListener('click', function() {
              carousel.scrollTo({ left: page * carousel.clientWidth, behavior: 'smooth' });
            });
          })(i);
          dots.appendChild(dot);
        }
        updateActive();
      }

      function updateActive() {
        if (!dots) return;
        var current = Math.round(carousel.scrollLeft / carousel.clientWidth);
        dots.querySelectorAll('.partner-social__scroll-dot').forEach(function(dot, idx) {
          dot.classList.toggle('active', idx === current);
        });
      }

      carousel.addEventListener('scroll', updateActive, { passive: true });
      window.addEventListener('resize', buildDots);
      buildDots();
    });
  });
</script>

{% schema %}
{
  "name": "Partner Social",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Connect With Us" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Stay up to date with eye care tips and more from [partner_name] and Peeq Pro." },
    { "type": "url", "id": "peeq_instagram", "label": "Peeq Pro Instagram URL" },
    { "type": "text", "id": "blog_handle", "label": "Blog handle", "default": "news" },
    { "type": "range", "id": "max_articles", "label": "Max articles", "min": 2, "max": 8, "step": 1, "default": 4 }
  ],
  "presets": [{ "name": "Partner Social" }]
}
{% endschema %}

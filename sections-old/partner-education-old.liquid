{%- comment -%}
  Section: Partner Education
  Displays eye health educational resource cards.
{%- endcomment -%}

<section class="partner-education">
  <div class="partner-container">
    <h2 class="partner-section-title">{{ section.settings.heading }}</h2>
    <p class="partner-section-subtitle">{{ section.settings.subheading }}</p>
    <div class="partner-education__grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'resource_card' -%}
          <div class="partner-education__card" {{ block.shopify_attributes }}>
            <div class="partner-education__icon">
              {%- case block.settings.icon -%}
                {%- when 'book' -%}
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--partner-primary)" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
                {%- when 'heart' -%}
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#34D399" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
                {%- when 'clipboard' -%}
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#818CF8" stroke-width="2"><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><rect x="8" y="2" width="8" height="4" rx="1" ry="1"/></svg>
              {%- endcase -%}
            </div>
            <h3 class="partner-education__card-title">{{ block.settings.title }}</h3>
            <p class="partner-education__card-desc">{{ block.settings.description }}</p>
            {%- if block.settings.link_url != blank -%}
              <a href="{{ block.settings.link_url }}" class="partner-education__card-link">
                {{ block.settings.link_text | default: 'Learn More' }} &rarr;
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

<style>
  .partner-education { background: var(--partner-page-bg); padding: 80px 0; }
  .partner-education__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; margin-top: 40px; }
  .partner-education__card { background: var(--partner-card-bg); border: 1px solid var(--partner-card-border); border-radius: var(--partner-radius-md); padding: 28px; box-shadow: var(--partner-card-shadow); transition: all 0.25s ease; }
  .partner-education__card:hover { box-shadow: var(--partner-card-shadow-hover); transform: translateY(-2px); }
  .partner-education__icon { width: 48px; height: 48px; border-radius: var(--partner-radius-sm); display: flex; align-items: center; justify-content: center; margin-bottom: 20px; background: var(--partner-primary-10); }
  .partner-education__card-title { font-size: 18px; font-weight: 600; color: var(--partner-text-heading); margin: 0 0 8px; }
  .partner-education__card-desc { font-size: 14px; color: var(--partner-text-muted); line-height: 1.6; margin: 0 0 16px; }
  .partner-education__card-link { font-size: 14px; font-weight: 600; color: var(--partner-primary); text-decoration: none; }
  .partner-education__card-link:hover { opacity: 0.8; }
  @media (max-width: 768px) { .partner-education { padding: 48px 0; } .partner-education__grid { grid-template-columns: 1fr; gap: 16px; } }
</style>

{% schema %}
{
  "name": "Partner Education",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Learn More About Your Eye Health" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "At Peeq Pro, we believe education empowers better care. Explore resources to help you manage your eye health." }
  ],
  "blocks": [
    {
      "type": "resource_card",
      "name": "Resource Card",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Resource Title" },
        { "type": "textarea", "id": "description", "label": "Description" },
        { "type": "select", "id": "icon", "label": "Icon", "options": [ { "value": "book", "label": "Book" }, { "value": "heart", "label": "Heart" }, { "value": "clipboard", "label": "Clipboard" } ], "default": "book" },
        { "type": "url", "id": "link_url", "label": "Link URL" },
        { "type": "text", "id": "link_text", "label": "Link Text", "default": "Learn More" }
      ]
    }
  ],
  "presets": [{ "name": "Partner Education", "blocks": [
    { "type": "resource_card", "settings": { "title": "Eye Care Articles", "description": "Explore our full collection of expert articles on eye health, dry eye care, and wellness tips.", "icon": "book", "link_text": "See All" } },
    { "type": "resource_card", "settings": { "title": "Menopause & Eye Health", "description": "How hormonal changes can affect dryness, comfort, and vision.", "icon": "heart", "link_text": "Learn More" } },
    { "type": "resource_card", "settings": { "title": "Good, Better, Best Dry Eye Care", "description": "A simple, step-by-step routine to help you manage dry eye symptoms at any level.", "icon": "clipboard", "link_text": "Read Article" } }
  ]}]
}
{% endschema %}

{%- assign partner_name = page.metafields.partner.name | default: 'Our Partner' -%}
{%- assign partner_instagram = page.metafields.partner.instagram_url -%}

<section class="partner-social">
  <div class="partner-container">
    <h2 class="partner-section-title">{{ section.settings.heading }}</h2>
    <p class="partner-section-subtitle">
      {{ section.settings.subheading | replace: '[partner_name]', partner_name }}
    </p>

    <div class="partner-social__buttons">
      {%- if partner_instagram != blank -%}
        <a href="{{ partner_instagram }}" target="_blank" rel="noopener" class="partner-btn partner-btn--outline">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/></svg>
          Follow {{ partner_name }}
        </a>
      {%- endif -%}
      {%- if section.settings.peeq_instagram != blank -%}
        <a href="{{ section.settings.peeq_instagram }}" target="_blank" rel="noopener" class="partner-btn partner-btn--outline">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/></svg>
          Follow Peeq Pro
        </a>
      {%- endif -%}
    </div>

    {%- if section.settings.blog_handle != blank -%}
      {%- assign blog = blogs[section.settings.blog_handle] -%}
      {%- if blog != blank and blog.articles.size > 0 -%}
        <div class="partner-social__carousel">
          {%- for article in blog.articles limit: section.settings.max_articles -%}
            <a href="{{ article.url }}" class="partner-social__article-card">
              {%- if article.image != blank -%}
                <div class="partner-social__article-image">
                  <img src="{{ article.image | image_url: width: 400, height: 280, crop: 'center' }}" alt="{{ article.image.alt | escape }}" loading="lazy">
                </div>
              {%- else -%}
                <div class="partner-social__article-image partner-social__article-image--placeholder">
                  <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" opacity="0.3"><rect x="3" y="3" width="18" height="18" rx="2"/></svg>
                </div>
              {%- endif -%}
              <div class="partner-social__article-body">
                <span class="partner-social__article-tag">Peeq Pro</span>
                <h4 class="partner-social__article-title">{{ article.title }}</h4>
                <p class="partner-social__article-excerpt">{{ article.excerpt_or_content | strip_html | truncate: 80 }}</p>
              </div>
            </a>
          {%- endfor -%}
        </div>
      {%- endif -%}
    {%- endif -%}
  </div>
</section>

<style>
  .partner-social { background: var(--partner-section-bg); padding: 80px 0; }
  .partner-social__buttons { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; margin: 32px 0 40px; }
  .partner-social__carousel { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }
  .partner-social__article-card { background: var(--partner-card-bg); border: 1px solid var(--partner-card-border); border-radius: var(--partner-radius-md); overflow: hidden; text-decoration: none; color: inherit; box-shadow: var(--partner-card-shadow); transition: all 0.25s ease; }
  .partner-social__article-card:hover { box-shadow: var(--partner-card-shadow-hover); transform: translateY(-2px); }
  .partner-social__article-image { aspect-ratio: 16/11; overflow: hidden; background: var(--partner-section-bg-alt); display: flex; align-items: center; justify-content: center; }
  .partner-social__article-image img { width: 100%; height: 100%; object-fit: cover; }
  .partner-social__article-body { padding: 16px; }
  .partner-social__article-tag { display: inline-block; font-size: 11px; font-weight: 600; color: var(--partner-primary); background: var(--partner-primary-10); padding: 3px 8px; border-radius: var(--partner-radius-sm); margin-bottom: 8px; }
  .partner-social__article-title { font-size: 15px; font-weight: 600; color: var(--partner-text-heading); margin: 0 0 6px; line-height: 1.3; }
  .partner-social__article-excerpt { font-size: 13px; color: var(--partner-text-muted); margin: 0; line-height: 1.5; }
  @media (max-width: 1024px) { .partner-social__carousel { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 768px) { .partner-social { padding: 48px 0; } .partner-social__carousel { grid-template-columns: repeat(2, 1fr); gap: 12px; } }
  @media (max-width: 480px) { .partner-social__carousel { grid-template-columns: 1fr; } }
</style>

{% schema %}
{
  "name": "Partner Social",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Connect With Us" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Stay up to date with eye care tips and more from [partner_name] and Peeq Pro." },
    { "type": "url", "id": "peeq_instagram", "label": "Peeq Pro Instagram URL" },
    { "type": "text", "id": "blog_handle", "label": "Blog handle", "default": "news" },
    { "type": "range", "id": "max_articles", "label": "Max articles", "min": 2, "max": 8, "step": 1, "default": 4 }
  ],
  "presets": [{ "name": "Partner Social" }]
}
{% endschema %}
